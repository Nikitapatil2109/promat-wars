# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Cryptographic key for server session signing and HMAC validation.
SESSION_SECRET="ecomind_secure_session_secret_change_in_production"

# NODE_ENV: Set to development or production
NODE_ENV="development"

# PORT: Server listener port (defaults to 3000 in AI Studio environment)
PORT=3000
